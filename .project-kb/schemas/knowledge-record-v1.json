{
  "$id": "https://project-kb.local/schema/knowledge-record-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "enum": [
        "verified",
        "generated",
        "inferred"
      ]
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "minLength": 1,
      "type": "string"
    },
    "last_generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownership": {
      "enum": [
        "generated",
        "draft",
        "curated",
        "decision"
      ]
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "sources": {
      "items": {
        "$id": "https://project-kb.local/schema/source-reference-v1.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "hash": {
            "pattern": "^sha256:",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "enum": [
              "file",
              "symbol",
              "commit",
              "config",
              "task",
              "decision"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "fresh",
        "potentially_stale",
        "stale",
        "conflicted"
      ]
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "path",
    "ownership",
    "confidence",
    "status",
    "sources"
  ],
  "type": "object"
}
